PORT=3000
# 127.0.0.1 keeps the dashboard local. On the server Caddy proxies HTTPS to it, so keep 127.0.0.1 there too.
HOST=127.0.0.1
SHOP_NAME=Toko Saya

# TiDB Cloud Serverless (or any MySQL 8 compatible server). The database is created on first start.
# TiDB console → your cluster → Connect → copy user, password and host. Use wamon_dev locally, wamon in production.
DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/wamon_dev
# DB_SSL=false   # only for a local MySQL without TLS

# Where WhatsApp login sessions are kept (one folder per linked number). Must survive restarts.
DATA_DIR=./data

# Dashboard login
ADMIN_PASSWORD=
# Long random string used to sign login cookies, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

LOG_LEVEL=info
